# 로컬 개발용 예시입니다. 실제 비밀값은 .env에만 저장하고 Git에 추가하지 마세요.
APP_ENVIRONMENT=development
APP_API_BASE_URL=http://127.0.0.1:8000

# 나중에 공개 클라이언트 흐름이 필요할 때에만 공개 가능한 설정을 넣습니다.
APP_SUPABASE_URL=
APP_SUPABASE_PUBLISHABLE_KEY=

# 서비스 키와 데이터베이스 URL은 서버 전용입니다. 데스크톱 앱이나 배포 파일에 넣지 마세요.
APP_SUPABASE_SERVICE_KEY=
APP_DATABASE_URL=
