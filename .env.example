# 로컬 개발용 예시입니다. 실제 비밀값은 .env에만 저장하고 Git에 추가하지 마세요.
APP_ENVIRONMENT=development
APP_API_BASE_URL=http://127.0.0.1:8000
APP_FILE_BUCKET=business-files

# Supabase 프로젝트 URL과 publishable key입니다. publishable key만 클라이언트 흐름에
# 사용할 수 있으며, 실제 값은 로컬 .env에만 입력합니다.
APP_SUPABASE_URL=
APP_SUPABASE_PUBLISHABLE_KEY=

# 서비스 키와 데이터베이스 URL은 서버 전용 비밀값입니다. 데스크톱 앱, 배포 파일,
# 클라이언트 로그에 넣거나 Git에 추가하지 마세요.
APP_SUPABASE_SERVICE_KEY=
APP_PLATFORM_ADMIN_USER_IDS=
APP_DATABASE_URL=

# ---- 서버 배포 설정(SEC-01~03). 값을 비워 두면 기본값을 쓴다. 자세한 설명: docs/guide/admin/deployment.md ----
# 일반 API 바인딩 주소/포트. 기본은 127.0.0.1:8000(리버스 프록시 뒤에서만 외부에 연다). 0.0.0.0 은 경고가 남는다.
APP_API_HOST=
APP_API_PORT=
# 신뢰할 프록시: false(기본) | true | 홉 수 | 프록시 IP/CIDR 쉼표 목록(권장: nginx/Caddy 가 같은 서버면 127.0.0.1).
# 신뢰하지 않는 상태에서 X-Forwarded-For 를 믿으면 로그인 시도 제한을 우회당한다.
APP_TRUST_PROXY=
# 요청 본문 최대 바이트(기본 1048576), 로그 수준(fatal|error|warn|info|debug|trace|silent, 기본 info).
APP_BODY_LIMIT_BYTES=
APP_LOG_LEVEL=

# 로그인·회원가입·토큰 갱신 시도 제한(메모리 기반, 인스턴스별). 기본: 로그인 실패 10회/600초, 이메일 합산 30회, 회원가입 5회/3600초, 갱신 60회/600초.
APP_AUTH_RATE_LIMIT_ENABLED=
APP_AUTH_LOGIN_MAX=
APP_AUTH_LOGIN_WINDOW_SEC=
APP_AUTH_LOGIN_EMAIL_MAX=
APP_AUTH_SIGNUP_MAX=
APP_AUTH_SIGNUP_WINDOW_SEC=
APP_AUTH_REFRESH_MAX=
APP_AUTH_REFRESH_WINDOW_SEC=
# 로그인 실패 응답의 최소 지연(밀리초, 기본 250). 계정 존재 여부를 응답 시간으로 구분하지 못하게 한다.
APP_AUTH_FAILURE_MIN_MS=

# 관리자 API(admin-server, 서비스 키 사용)는 별도 프로세스·포트에서만 실행한다. 일반 API 는 서비스 키를 읽지 않는다.
# APP_SUPABASE_SERVICE_KEY / APP_PLATFORM_ADMIN_USER_IDS 는 관리자 서버를 실행하는 환경에만 두세요.
APP_ADMIN_HOST=
APP_ADMIN_PORT=

# 운영(production)에서는 BUSINESS_ASSISTANT_DEV_AUTO_LOGIN 을 두지 마세요(서버가 시작을 거부합니다).
# NODE_ENV=production 으로 실행하면 이 점검이 켜집니다.
