# 로컬 개발용 예시입니다. 실제 비밀값은 .env에만 저장하고 Git에 추가하지 마세요.
APP_ENVIRONMENT=development
APP_API_BASE_URL=http://127.0.0.1:8000

# Supabase 프로젝트 URL과 publishable key입니다. publishable key만 클라이언트 흐름에
# 사용할 수 있으며, 실제 값은 로컬 .env에만 입력합니다.
APP_SUPABASE_URL=
APP_SUPABASE_PUBLISHABLE_KEY=

# 서비스 키와 데이터베이스 URL은 서버 전용 비밀값입니다. 데스크톱 앱, 배포 파일,
# 클라이언트 로그에 넣거나 Git에 추가하지 마세요.
APP_SUPABASE_SERVICE_KEY=
APP_DATABASE_URL=
