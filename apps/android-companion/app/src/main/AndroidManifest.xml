<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: Telecom requires this to also screen callers already in device contacts.
         The app does not query or upload the device contact database. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application
        android:allowBackup="false"
        android:label="Business Assistant 전화 연동"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="${allowCleartext}">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".call.CustomerCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
